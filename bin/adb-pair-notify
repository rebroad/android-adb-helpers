#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
export PATH="/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/bin/applets:${PATH:-}"

STATE_DIR="${HOME}/.cache/adb-pair-notify"
LOG_FILE="${STATE_DIR}/attempt.log"
STATE_FILE="${STATE_DIR}/state"
LOCK_FILE="${STATE_DIR}/monitor.pid"
INPUT_FILE="${STATE_DIR}/input.pid"
SUBMIT_LOCK="${STATE_DIR}/submit.lock"
RETRY_FILE="${STATE_DIR}/retry"
SELF="${HOME}/bin/adb-pair-notify"
MDNS="${HOME}/bin/adb-mdns-discover"
NOTIFICATION_ID="adb-pair"
STATUS_CHANNEL_ID="adb-pairing-status"

mkdir -p "${STATE_DIR}"
touch "${LOG_FILE}"

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "${LOG_FILE}"
}

die() {
  echo "adb-pair-notify: $*" >&2
  exit 2
}

remove_notification() {
  if command -v termux-notification-remove >/dev/null 2>&1; then
    termux-notification-remove "${NOTIFICATION_ID}" >/dev/null 2>&1 || true
  fi
}

notify() {
  remove_notification
  termux-notification --id "${NOTIFICATION_ID}" --title "$1" --content "$2" "${@:3}" \
    >>"${LOG_FILE}" 2>&1 || log "notification failed: $1"
}

ensure_status_channel() {
  if command -v termux-notification-channel >/dev/null 2>&1; then
    termux-notification-channel "${STATUS_CHANNEL_ID}" "ADB pairing status" >/dev/null 2>&1 ||
      log "notification channel setup failed: ${STATUS_CHANNEL_ID}"
  fi
}

notify_status() {
  ensure_status_channel
  notify "$1" "$2" --channel "${STATUS_CHANNEL_ID}" --priority default "${@:3}"
}

write_state() {
  local host="$1" debug_port="$2" pair_host="$3" pair_port="$4"
  printf '%s|%s|%s|%s\n' "${host}" "${debug_port}" "${pair_host}" "${pair_port}" \
    > "${STATE_FILE}.new"
  mv -f "${STATE_FILE}.new" "${STATE_FILE}"
}

input_active() {
  local input_pid
  if [ ! -d "${SUBMIT_LOCK}" ] || [ ! -s "${INPUT_FILE}" ]; then
    return 1
  fi
  read -r input_pid < "${INPUT_FILE}" || return 1
  if kill -0 "${input_pid}" 2>/dev/null; then
    return 0
  fi
  rm -f "${INPUT_FILE}"
  rmdir "${SUBMIT_LOCK}" 2>/dev/null || true
  return 1
}

format_endpoint() {
  local host="$1" port="$2"
  case "${host}" in
    *:*) printf '[%s]:%s' "${host}" "${port}" ;;
    *) printf '%s:%s' "${host}" "${port}" ;;
  esac
}

adb_connected() {
  local endpoint
  endpoint="$(format_endpoint "$1" "$2")"
  adb devices 2>>"${LOG_FILE}" | awk -v endpoint="${endpoint}" \
    '$1 == endpoint && $2 == "device" {found=1} END {exit !found}'
}

adb_connect_succeeded() {
  local endpoint="$1" response="$2"
  [[ "${response}" == *"connected to ${endpoint}"* ]]
}

probe_tcp_port() {
  local host="$1" port="$2" probe_status result
  set +e
  timeout 2 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$host" "$port" >/dev/null 2>&1
  probe_status=$?
  set -e
  case "$probe_status" in
    0) result=listening ;;
    124) result=timed-out ;;
    1) result=refused-or-unavailable ;;
    *) result="error-$probe_status" ;;
  esac
  log "tcp probe host=$host port=$port result=$result"
}

tcp_port_open() {
  local host="$1" port="$2"
  set +e
  timeout 1 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "${host}" "${port}" >/dev/null 2>&1
  local status=$?
  set -e
  return "${status}"
}

submit() {
  local reply="$1" host debug_port pair_host pair_port pin output pair_endpoint debug_endpoint
  local input_marker="${INPUT_FILE}.new"

  if ! mkdir "${SUBMIT_LOCK}" 2>/dev/null; then
    log "submit rejected: another pairing attempt is active"
    exit 0
  fi
  printf '%s\n' "$$" > "${input_marker}"
  mv -f "${input_marker}" "${INPUT_FILE}"
  trap 'rm -f "${INPUT_FILE}"; rmdir "${SUBMIT_LOCK}" 2>/dev/null || true' EXIT

  log "submit started pid=$$ reply_length=${#reply}"
  IFS='|' read -r host debug_port pair_host pair_port < "${STATE_FILE}"
  read -r pin _ <<< "${reply}"
  [[ "${pin}" =~ ^[0-9]{6}$ ]] || {
    : > "${RETRY_FILE}"
    notify_status "ADB pairing" "PIN must be exactly six digits"
    exit 2
  }
  [[ "${host}" != "" && "${debug_port}" =~ ^[0-9]{1,5}$ ]] || {
    : > "${RETRY_FILE}"
    notify_status "ADB pairing" "ADB debugging endpoint is no longer available"
    exit 2
  }
  [[ "${pair_host}" != "" && "${pair_port}" =~ ^[0-9]{1,5}$ ]] || {
    : > "${RETRY_FILE}"
    notify_status "ADB pairing" "Pairing service is no longer available"
    exit 2
  }

  pair_endpoint="$(format_endpoint "${pair_host}" "${pair_port}")"
  debug_endpoint="$(format_endpoint "${host}" "${debug_port}")"
  log "adb pair started pid=$$ endpoint=${pair_endpoint}"
  set +e
  output="$(timeout 20 adb pair "${pair_endpoint}" "${pin}" 2>&1)"
  pair_status=$?
  set -e
  log "adb pair finished pid=$$ status=${pair_status} output=${output@Q}"
  if [ "${pair_status}" -ne 0 ]; then
    : > "${RETRY_FILE}"
    notify_status "ADB pairing failed" "${output:0:180}"
    exit 1
  fi
  connect_attempt=1
  connect_succeeded=1
  connect_output=""
  while [ "${connect_attempt}" -le 3 ]; do
    if [ "${connect_attempt}" -gt 1 ]; then
      backoff=$((connect_attempt - 1))
      log "adb connect retry pid=$$ attempt=${connect_attempt} sleep=${backoff}s endpoint=${debug_endpoint}"
      sleep "${backoff}"
    fi
    log "adb connect started pid=$$ attempt=${connect_attempt} endpoint=${debug_endpoint}"
    set +e
    attempt_output="$(timeout 20 adb connect "${debug_endpoint}" 2>&1)"
    connect_status=$?
    set -e
    connect_output="${attempt_output}"
    output="${output}
${attempt_output}"
    log "adb connect finished pid=$$ attempt=${connect_attempt} status=${connect_status} output=${attempt_output@Q}"
    if [ "${connect_status}" -ne 0 ] || ! adb_connect_succeeded "${debug_endpoint}" "${attempt_output}"; then
      probe_tcp_port "${host}" "${debug_port}"
    fi
    if [ "${connect_status}" -eq 0 ] && adb_connect_succeeded "${debug_endpoint}" "${attempt_output}"; then
      connect_succeeded=0
      break
    fi
    connect_attempt=$((connect_attempt + 1))
  done
  if [ "${connect_succeeded}" -ne 0 ]; then
    : > "${RETRY_FILE}"
    log "adb connect failed after 3 attempts endpoint=${debug_endpoint}"
    notify_status "ADB paired; connect failed" "${output:0:180}"
    exit 1
  fi
  log "adb success: ${output}"
}

if [ "${1:-}" = "--submit" ]; then
  [ "$#" -eq 2 ] || die "internal submit syntax"
  submit "$2"
  exit 0
fi

if [ "${1:-}" = "--daemon" ]; then
  [ "$#" -eq 1 ] || die "usage: adb-pair-notify [--daemon]"
  exec </dev/null >>"${LOG_FILE}" 2>&1
  set --
fi

[ "$#" -eq 0 ] || die "usage: adb-pair-notify [--daemon]"

if [ -s "${LOCK_FILE}" ]; then
  read -r old_pid < "${LOCK_FILE}" || true
  if [ -n "${old_pid:-}" ] && kill -0 "${old_pid}" 2>/dev/null; then
    die "monitor already running (pid ${old_pid})"
  fi
fi
printf '%s\n' "$$" > "${LOCK_FILE}"
trap 'rm -f "${LOCK_FILE}" "${INPUT_FILE}" "${STATE_FILE}.new"' EXIT
trap 'exit 143' INT TERM
write_state "" "" "" ""

action="/data/data/com.termux/files/usr/bin/bash ${SELF} --submit \"\$REPLY\""
next_reminder=0
pair_notice_key=""
poll_sleep=9

log "persistent monitor started"
while :; do
  discovery="$(${MDNS} 1 2>>"${LOG_FILE}" || true)"
  discovered_host=""
  discovered_debug_port=""
  discovered_pair_host=""
  discovered_pair_port=""

  connect_fallback_host=""
  connect_fallback_port=""
  while IFS=$'	' read -r _ candidate_host candidate_port; do
    [[ "${candidate_port}" =~ ^[0-9]{1,5}$ ]] || continue
    if [ -z "${connect_fallback_host}" ]; then
      connect_fallback_host="${candidate_host}"
      connect_fallback_port="${candidate_port}"
    fi
    if tcp_port_open "${candidate_host}" "${candidate_port}"; then
      discovered_host="${candidate_host}"
      discovered_debug_port="${candidate_port}"
      log "debug endpoint selected host=${candidate_host} port=${candidate_port} (TCP listener reachable)"
      break
    fi
  done <<< "$(printf '%s\n' "${discovery}" | awk '$1 == "connect" {print}')"
  if [ -z "${discovered_debug_port}" ] && [ -n "${connect_fallback_host}" ]; then
    discovered_host="${connect_fallback_host}"
    discovered_debug_port="${connect_fallback_port}"
    log "debug endpoint selected host=${discovered_host} port=${discovered_debug_port} (fallback; no TCP listener reachable)"
  fi
  pair_line="$(printf '%s\n' "${discovery}" | awk '$1 == "pairing" {print; exit}')"
  if [ -n "${pair_line}" ]; then
    read -r _ discovered_pair_host discovered_pair_port <<< "${pair_line}"
    [[ "${discovered_pair_port}" =~ ^[0-9]{1,5}$ ]] || {
      discovered_pair_host=""
      discovered_pair_port=""
    }
  fi
  [ -n "${discovered_host}" ] || discovered_host="${discovered_pair_host}"
  [ -n "${discovered_pair_host}" ] || discovered_pair_host="${discovered_host}"

  # adb-mdns-discover waits one second for replies. Use a four-second sleep
  # after a discovered debugging endpoint to make the complete poll cycle
  # approximately five seconds; otherwise retain the ten-second cycle.
  poll_sleep=9
  if [ -n "${discovered_host}" ] && [ -n "${discovered_debug_port}" ]; then
    poll_sleep=4
  fi

  now="$(date +%s)"
  if input_active; then
    sleep 1
    continue
  fi

  if [ -n "${discovered_host}" ] && [ -n "${discovered_debug_port}" ] && \
      adb_connected "${discovered_host}" "${discovered_debug_port}"; then
    remove_notification
    pair_notice_key=""
    rm -f "${RETRY_FILE}"
    write_state "${discovered_host}" "${discovered_debug_port}" "${discovered_pair_host}" "${discovered_pair_port}"
    sleep "${poll_sleep}"
    continue
  fi

  if [ -n "${discovered_host}" ] && [ -n "${discovered_pair_port}" ]; then
    write_state "${discovered_host}" "${discovered_debug_port}" "${discovered_pair_host}" "${discovered_pair_port}"
    current_pair_key="${discovered_pair_host}:${discovered_pair_port}"
    if [ "${current_pair_key}" != "${pair_notice_key}" ] || [ -e "${RETRY_FILE}" ]; then
      rm -f "${RETRY_FILE}"
      notify "ADB pairing available" "Tap Enter PIN and enter the six-digit pairing PIN" \
        --ongoing --priority max --button1 "Enter PIN" --button1-action "${action}"
      log "pairing notification posted host=${discovered_pair_host} port=${discovered_pair_port}"
      pair_notice_key="${current_pair_key}"
    fi
    sleep "${poll_sleep}"
    continue
  fi

  write_state "${discovered_host}" "${discovered_debug_port}" "" ""
  pair_notice_key=""
  if [ "${now}" -ge "${next_reminder}" ]; then
    reminder_content="Pair this device to reconnect ADB"
    if [ -n "${discovered_host}" ] && [ -n "${discovered_debug_port}" ]; then
      reminder_content="ADB debugging endpoint: $(format_endpoint "${discovered_host}" "${discovered_debug_port}"). Pair this device to reconnect ADB"
    fi
    notify_status "Wireless debugging is not paired" "${reminder_content}" --priority default
    log "not-paired reminder posted"
    next_reminder=$((now + 30))
  fi
  sleep "${poll_sleep}"
done
