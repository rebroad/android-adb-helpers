#!/usr/bin/env python3
"""Persistent Android wireless-debugging pairing monitor."""
import fcntl
import os
import re
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

HOME = os.environ.get("HOME", str(Path.home()))
PREFIX = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
TERMUX_MODE = Path("/data/data/com.termux/files/usr").is_dir()
DESKTOP_MODE = not TERMUX_MODE and bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
STATE_DIR = Path(os.environ.get("ADB_PAIR_NOTIFY_STATE_DIR", Path(HOME) / ".cache/adb-pair-notify"))
LOG_FILE = STATE_DIR / "attempt.log"
STATE_FILE = STATE_DIR / "state"
LOCK_FILE = STATE_DIR / "monitor.pid"
INPUT_FILE = STATE_DIR / "input.pid"
SUBMIT_LOCK = STATE_DIR / "submit.lock"
RETRY_FILE = STATE_DIR / "retry"
SELF = Path(__file__).resolve()
PAIR_NOTIFICATION_ID = "adb-pair"
STATUS_NOTIFICATION_ID = "adb-pair-status"
STATUS_CHANNEL_ID = "adb-pairing-status"
PAIR_CHANNEL_PREFIX = "adb-pairing-pin"
pair_notification_visible = False
status_notification_visible = False
SERVICES = {"_adb-tls-pairing._tcp.local": "pairing", "_adb-tls-connect._tcp.local": "connect"}
GROUP = "224.0.0.251"
MDNS_PORT = 5353


def log(message):
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + message + "\n")


def run(args, timeout=None):
    try:
        return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=timeout, check=False).stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)


def format_endpoint(host, port):
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


def remove_notification(notification_id):
    global pair_notification_visible, status_notification_visible
    command = shutil.which("termux-notification-remove")
    if command:
        subprocess.run([command, notification_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if notification_id == PAIR_NOTIFICATION_ID:
        pair_notification_visible = False
    elif notification_id == STATUS_NOTIFICATION_ID:
        status_notification_visible = False


def notify(notification_id, title, content, *extra):
    global pair_notification_visible, status_notification_visible
    backend = "notify-send" if DESKTOP_MODE else "termux-notification"
    command = shutil.which(backend)
    if not command:
        log(f"notification failed: {backend} unavailable")
        return
    args = [command, title, content] if DESKTOP_MODE else [command, "--id", notification_id, "--title", title, "--content", content, *extra]
    result = subprocess.run(args,
                            text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    if result.returncode:
        log(f"notification failed: {title}: {result.stdout.strip()}")
    elif notification_id == PAIR_NOTIFICATION_ID:
        pair_notification_visible = True
    elif notification_id == STATUS_NOTIFICATION_ID:
        status_notification_visible = True


def ensure_status_channel():
    command = shutil.which("termux-notification-channel")
    if command and subprocess.run([command, STATUS_CHANNEL_ID, "ADB pairing status"], stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, check=False).returncode:
        log(f"notification channel setup failed: {STATUS_CHANNEL_ID}")


def ensure_pair_channel(channel_id):
    command = Path(PREFIX) / "libexec/termux-api"
    if not command.is_file() or not os.access(command, os.X_OK):
        log("notification channel setup unavailable: termux-api client not found")
        return False
    args = [str(command), "NotificationChannel", "--es", "id", channel_id, "--es", "name", "ADB pairing PIN", "--es", "priority", "max"]
    if subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode:
        log(f"notification channel setup failed: {channel_id}")
        return False
    return True


def notify_status(title, content, *extra):
    if DESKTOP_MODE:
        notify(STATUS_NOTIFICATION_ID, title, content)
        return
    ensure_status_channel()
    notify(STATUS_NOTIFICATION_ID, title, content, "--channel", STATUS_CHANNEL_ID, "--priority", "default", *extra)


def xfce_prompt(pair_host, pair_port):
    """Ask for the PIN shown by Android Wireless Debugging."""
    command = shutil.which("zenity") or shutil.which("yad")
    if not command:
        log("XFCE pairing prompt unavailable: install zenity or yad")
        notify_status("ADB pairing", "Install zenity or yad to enter the pairing PIN")
        return ""
    if Path(command).name == "yad":
        args = [command, "--entry", "--title=ADB pairing available",
                "--text=Enter the six-digit pairing PIN shown on the phone.",
                "--button=Pair:0", "--button=Cancel:1", "--width=420"]
    else:
        args = [command, "--entry", "--title=ADB pairing available",
                "--text=Enter the six-digit pairing PIN shown on the phone.",
                "--ok-label=Pair", "--cancel-label=Cancel", "--width=420"]
    log(f"XFCE pairing dialog shown host={pair_host} port={pair_port}")
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    if result.returncode:
        log("XFCE pairing dialog cancelled")
        return ""
    return result.stdout.strip()


def write_state(host, debug_port, pair_host, pair_port):
    tmp = Path(str(STATE_FILE) + ".new")
    tmp.write_text(f"{host}|{debug_port}|{pair_host}|{pair_port}\n")
    tmp.replace(STATE_FILE)


def read_state():
    try:
        values = STATE_FILE.read_text().strip().split("|")
        return (values + [""] * 4)[:4]
    except OSError:
        return ["", "", "", ""]


def input_active():
    if not SUBMIT_LOCK.is_dir() or not INPUT_FILE.is_file():
        return False
    try:
        pid = int(INPUT_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        INPUT_FILE.unlink(missing_ok=True)
        try: SUBMIT_LOCK.rmdir()
        except OSError: pass
        return False


def tcp_open(host, port, timeout=1):
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except OSError:
        return False


def adb_connected(host, port):
    endpoint = format_endpoint(host, port)
    output = run(["adb", "devices"], timeout=10)
    return any(line.split()[:2] == [endpoint, "device"] for line in output.splitlines())


def encode_name(name):
    return b"".join(bytes([len(part)]) + part.encode() for part in name.split(".")) + b"\0"


def read_name(packet, offset):
    labels, jumped, end = [], False, offset
    while True:
        length = packet[offset]
        if length == 0:
            return ".".join(labels), (offset + 1 if not jumped else end)
        if length & 0xc0 == 0xc0:
            pointer = ((length & 0x3f) << 8) | packet[offset + 1]
            label, _ = read_name(packet, pointer)
            labels.append(label)
            if not jumped: end = offset + 2
            jumped = True
            return ".".join(labels), end
        offset += 1
        labels.append(packet[offset:offset + length].decode(errors="replace"))
        offset += length


def records(packet):
    if len(packet) < 12: return []
    questions, answers, authority, additional = struct.unpack_from("!HHHH", packet, 4)
    offset, result = 12, []
    for _ in range(questions):
        _, offset = read_name(packet, offset); offset += 4
    for _ in range(answers + authority + additional):
        name, offset = read_name(packet, offset)
        rtype, _, _, length = struct.unpack_from("!HHIH", packet, offset); offset += 10
        data_offset = offset
        if rtype == 12:
            value, _ = read_name(packet, data_offset); result.append((name, "PTR", value))
        elif rtype == 33 and length >= 6:
            _, _, port = struct.unpack_from("!HHH", packet, data_offset)
            target, _ = read_name(packet, data_offset + 6); result.append((name, "SRV", (target, port)))
        elif rtype == 1 and length == 4:
            result.append((name, "A", socket.inet_ntoa(packet[data_offset:data_offset + 4])))
        offset += length
    return result


def interface_addresses(sock):
    addresses = []
    try:
        interface_names = socket.if_nameindex()
    except OSError:
        interface_names = []
    for _, name in interface_names:
        if name == "lo": continue
        try:
            request = struct.pack("256s", name.encode())
            result = fcntl.ioctl(sock.fileno(), 0x8915, request)
            address = socket.inet_ntoa(result[20:24])
            if not address.startswith("127.") and address not in addresses: addresses.append(address)
        except (OSError, ValueError): pass
    if not addresses:
        try:
            output = subprocess.check_output(["ifconfig"], stderr=subprocess.DEVNULL, text=True)
        except (OSError, subprocess.SubprocessError):
            output = ""
        for line in output.splitlines():
            fields = line.split()
            if len(fields) >= 2 and fields[0] == "inet" and not fields[1].startswith("127.") and fields[1] not in addresses:
                addresses.append(fields[1])
    return addresses or ["0.0.0.0"]


def discover(seconds=1):
    query = b"".join(encode_name(name) + struct.pack("!HH", 12, 1) for name in SERVICES)
    packet = struct.pack("!HHHHHH", 0, 0, len(SERVICES), 0, 0, 0) + query
    found = {}
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(("0.0.0.0", MDNS_PORT))
        interfaces = interface_addresses(sock)
        for interface in interfaces:
            try: sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, struct.pack("=4s4s", socket.inet_aton(GROUP), socket.inet_aton(interface)))
            except OSError: pass
        for interface in interfaces:
            try:
                sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(interface))
                sock.sendto(packet, (GROUP, MDNS_PORT))
            except OSError: pass
        sock.settimeout(0.5); deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            try: data, source = sock.recvfrom(65535)
            except socket.timeout: continue
            parsed = records(data)
            srv = {n: v for n, k, v in parsed if k == "SRV"}
            ipv4 = {n: v for n, k, v in parsed if k == "A"}
            for name, kind, value in parsed:
                if kind == "PTR" and name in SERVICES and value in srv:
                    target, port = srv[value]
                    found[(SERVICES[name], ipv4.get(target, source[0]), port)] = True
        sock.close()
    except OSError as e:
        log(f"mDNS discovery failed: {e}")
    return sorted(found)


def submit(reply):
    try: SUBMIT_LOCK.mkdir()
    except FileExistsError:
        log("submit rejected: another pairing attempt is active"); return 0
    INPUT_FILE.write_text(f"{os.getpid()}\n")
    try:
        host, debug_port, pair_host, pair_port = read_state()
        pin = reply.split()[0] if reply.split() else ""
        if not re.fullmatch(r"[0-9]{6}", pin):
            RETRY_FILE.touch(); notify_status("ADB pairing", "PIN must be exactly six digits"); return 2
        if not host or not re.fullmatch(r"[0-9]{1,5}", debug_port):
            RETRY_FILE.touch(); notify_status("ADB pairing", "ADB debugging endpoint is no longer available"); return 2
        if not pair_host or not re.fullmatch(r"[0-9]{1,5}", pair_port):
            RETRY_FILE.touch(); notify_status("ADB pairing", "Pairing service is no longer available"); return 2
        pair_endpoint, debug_endpoint = format_endpoint(pair_host, pair_port), format_endpoint(host, debug_port)
        log(f"adb pair started pid={os.getpid()} endpoint={pair_endpoint}")
        pair = run(["adb", "pair", pair_endpoint, pin], timeout=20)
        log(f"adb pair finished pid={os.getpid()} status={'0' if 'Successfully paired' in pair else '1'} output={pair!r}")
        if "Successfully paired" not in pair:
            RETRY_FILE.touch(); notify_status("ADB pairing failed", pair[:180]); return 1
        for attempt in range(1, 4):
            if attempt > 1: time.sleep(attempt - 1)
            output = run(["adb", "connect", debug_endpoint], timeout=20)
            log(f"adb connect finished pid={os.getpid()} attempt={attempt} output={output!r}")
            if "connected to " + debug_endpoint in output:
                log(f"adb success: {pair}\n{output}"); return 0
        RETRY_FILE.touch(); notify_status("ADB paired; connect failed", pair[:180]); return 1
    finally:
        INPUT_FILE.unlink(missing_ok=True)
        try: SUBMIT_LOCK.rmdir()
        except OSError: pass


def daemon():
    STATE_DIR.mkdir(parents=True, exist_ok=True); LOG_FILE.touch()
    if LOCK_FILE.exists():
        try:
            old = int(LOCK_FILE.read_text())
            os.kill(old, 0); raise SystemExit(f"monitor already running (pid {old})")
        except (OSError, ValueError): pass
    LOCK_FILE.write_text(f"{os.getpid()}\n"); write_state("", "", "", "")
    pair_notice_key, channel_serial, next_reminder = "", 0, 0
    last_state = "unknown"
    def stop(_sig, _frame):
        LOCK_FILE.unlink(missing_ok=True); INPUT_FILE.unlink(missing_ok=True); sys.exit(143)
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    action = f'{shlex.quote(sys.executable)} {shlex.quote(str(SELF))} --submit "$REPLY"'
    log("persistent monitor started")
    while True:
        discovery = discover(1)
        connects = [(h, p) for kind, h, p in discovery if kind == "connect"]
        pairings = [(h, p) for kind, h, p in discovery if kind == "pairing"]
        host = debug_port = pair_host = pair_port = ""
        fallback = connects[0] if connects else None
        for candidate_host, candidate_port in connects:
            if tcp_open(candidate_host, candidate_port): host, debug_port = candidate_host, str(candidate_port); break
        if not debug_port and fallback: host, debug_port = fallback[0], str(fallback[1])
        if pairings: pair_host, pair_port = pairings[0][0], str(pairings[0][1])
        host = host or pair_host; pair_host = pair_host or host
        poll_sleep = 4 if host and debug_port else 9
        now = int(time.time())
        if input_active(): time.sleep(1); continue
        if host and debug_port and adb_connected(host, debug_port):
            if last_state != "connected":
                if pair_notification_visible:
                    remove_notification(PAIR_NOTIFICATION_ID)
                if status_notification_visible:
                    remove_notification(STATUS_NOTIFICATION_ID)
            pair_notice_key = ""; RETRY_FILE.unlink(missing_ok=True); write_state(host, debug_port, pair_host, pair_port); last_state = "connected"; time.sleep(poll_sleep); continue
        if host and pair_port:
            write_state(host, debug_port, pair_host, pair_port)
            key = f"{pair_host}:{pair_port}"
            if DESKTOP_MODE:
                if key != pair_notice_key or RETRY_FILE.exists():
                    RETRY_FILE.unlink(missing_ok=True)
                    pair_notice_key = key
                    reply = xfce_prompt(pair_host, pair_port)
                    if reply:
                        submit(reply)
                last_state = "pairing"
                time.sleep(poll_sleep)
                continue
            if key != pair_notice_key or RETRY_FILE.exists():
                RETRY_FILE.unlink(missing_ok=True); channel_serial += 1; channel = f"{PAIR_CHANNEL_PREFIX}-{int(time.time())}-{os.getpid()}-{channel_serial}"
                if ensure_pair_channel(channel):
                    if status_notification_visible:
                        remove_notification(STATUS_NOTIFICATION_ID)
                    notify(PAIR_NOTIFICATION_ID, "ADB pairing available", "Tap Enter PIN and enter the six-digit pairing PIN", "--channel", channel, "--priority", "high", "--vibrate", "100,200,100", "--button1", "Enter PIN", "--button1-action", action)
                    log(f"pairing notification posted host={pair_host} port={pair_port}"); pair_notice_key = key
            last_state = "pairing"
            time.sleep(poll_sleep); continue
        write_state(host, debug_port, "", ""); pair_notice_key = ""
        if last_state != "unpaired" and pair_notification_visible:
            remove_notification(PAIR_NOTIFICATION_ID)
        last_state = "unpaired"
        if now >= next_reminder:
            content = "Pair this device to reconnect ADB" if not (host and debug_port) else f"ADB debugging endpoint: {format_endpoint(host, debug_port)}. Pair this device to reconnect ADB"
            notify_status("Wireless debugging is not paired", content, "--priority", "default"); log("not-paired reminder posted"); next_reminder = now + 30
        time.sleep(poll_sleep)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--submit": raise SystemExit(submit(sys.argv[2]))
    if len(sys.argv) == 2 and sys.argv[1] == "--daemon":
        log_fd = os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        os.dup2(log_fd, 1); os.dup2(log_fd, 2); os.close(log_fd)
    elif len(sys.argv) != 1: raise SystemExit("usage: adb-pair-notify [--daemon]")
    daemon()
