#!/data/data/com.termux/files/usr/bin/python
"""Show whole-device CPU and process activity through the ADB shell."""

import argparse
import subprocess
import sys
import time


def adb(*args):
    result = subprocess.run(
        ["adb", *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "adb command failed")
    return result.stdout


def cpu_stats():
    stats = {}
    for line in adb("shell", "cat", "/proc/stat").splitlines():
        fields = line.split()
        if not fields or not fields[0].startswith("cpu") or not fields[0][3:].isdigit():
            continue
        values = [int(value) for value in fields[1:]]
        idle = values[3] + (values[4] if len(values) > 4 else 0)
        stats[fields[0]] = (sum(values), idle)
    return stats


def cpu_usage(previous, current):
    usage = []
    for name in sorted(current, key=lambda value: int(value[3:])):
        if name not in previous:
            continue
        total_delta = current[name][0] - previous[name][0]
        idle_delta = current[name][1] - previous[name][1]
        percent = 0.0 if total_delta <= 0 else 100 * (total_delta - idle_delta) / total_delta
        usage.append((name, percent))
    return usage


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-d", "--delay", type=float, default=1.0, help="seconds between samples")
    parser.add_argument("-n", "--iterations", type=int, default=0, help="samples; 0 means continuous")
    parser.add_argument("-m", "--max-processes", type=int, default=20, help="processes to show")
    args = parser.parse_args()
    if args.delay <= 0 or args.iterations < 0 or args.max_processes < 1:
        parser.error("delay must be positive; iterations and max-processes must be non-negative/positive")

    previous = cpu_stats()
    iteration = 0
    try:
        while args.iterations == 0 or iteration < args.iterations:
            time.sleep(args.delay)
            current = cpu_stats()
            processes = adb(
                "shell", "top", "-b", "-n", "1", "-m", str(args.max_processes),
                "-o", "PID,CPU,RES,NAME"
            ).rstrip()
            print("\033[2J\033[H", end="")
            print("ADB device CPU usage (all online CPUs)")
            print("  " + "  ".join(f"{name}={percent:5.1f}%" for name, percent in cpu_usage(previous, current)))
            print()
            print(processes)
            sys.stdout.flush()
            previous = current
            iteration += 1
    except KeyboardInterrupt:
        return 130
    except (OSError, RuntimeError, ValueError) as error:
        print(f"adb-top: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
